# Pumat local credentials template.
# Copy to .env and fill in real values: cp .env.example .env
# .env is gitignored. Never commit real secrets.

# --- GitHub ---------------------------------------------------------------
# Repository in owner/name form, e.g. my-org/pumat
GITHUB_REPOSITORY=OWNER/REPO

# Fine-grained personal access token for this repository.
# Required permissions: Contents (read/write), Pull requests (read/write),
# Actions (read), Workflows (read/write, only if pushing .github/workflows).
GITHUB_TOKEN=github_pat_REPLACE_ME

# --- GitHub Container Registry (solver/parser OCI artifacts, §7.7) --------
# Classic PAT with write:packages and read:packages (fine-grained tokens
# cannot push to GHCR yet). Leave empty until solver images are published.
GHCR_USERNAME=REPLACE_ME
GHCR_TOKEN=ghp_REPLACE_ME

# --- Cosign (optional, local development signing only) --------------------
# Release signing uses Sigstore keyless in CI (§7.6), so no key is needed
# there. Fill these only to sign test artifacts locally.
# COSIGN_KEY=./secrets/cosign.key
# COSIGN_PASSWORD=REPLACE_ME
